{
  "name": "pebble-arcs",
  "author": "thementalgoose",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "ARCs",
    "uuid": "0122e256-9254-4bbd-9079-f4afd0819b1a",
    "sdkVersion": "3",
    "manifestVersion": 2,
    "enableMultiJS": true,
    "capabilities": [
      "health",
      "configurable"
    ],
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "DarkTheme",
      "QuietTimeIndicator",
      "DisconnectIndicator",
      "OutlinedArcs",
      "ShowIndicatorText",
      "IndicatorWidth",
      "TopLeft_Option",
      "TopLeft_Colour",
      "TopLeft_Min",
      "TopLeft_Max",
      "TopRight_Option",
      "TopRight_Colour",
      "TopRight_Min",
      "TopRight_Max",
      "BottomLeft_Option",
      "BottomLeft_Colour",
      "BottomLeft_Min",
      "BottomLeft_Max",
      "BottomRight_Option",
      "BottomRight_Colour",
      "BottomRight_Min",
      "BottomRight_Max",
      "WeatherTemperature",
      "WeatherCondition",
      "WeatherRequestUpdate",
      "WeatherUpdateInterval",
      "WeatherUseCelsius",
      "PhoneBattery",
      "Complication1_Percent",
      "Complication1_Label",
      "Complication2_Percent",
      "Complication2_Label",
      "Complication3_Percent",
      "Complication3_Label",
      "Complication4_Percent",
      "Complication4_Label",
      "Complication5_Percent",
      "Complication5_Label",
      "AnimateIndicators"
    ],
    "resources": {
      "media": [
        {
          "file": "images/icon_bw.png",
          "type": "bitmap",
          "name": "MENU_ICON",
          "memoryFormat": "1Bit",
          "menuIcon": true,
          "targetPlatforms": [
            "aplite",
            "diorite",
            "flint"
          ]
        },
        {
          "file": "images/icon_color.png",
          "type": "bitmap",
          "name": "MENU_ICON",
          "targetPlatforms": [
            "basalt",
            "chalk",
            "emery",
            "gabbro"
          ]
        }
      ]
    },
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "api.open-meteo.com"
          ]
        },
        "reason": "To fetch the current weather",
        "required": false
      },
      {
        "name": "Location",
        "reason": "To show the weather where you are",
        "required": false
      },
      {
        "name": "Health",
        "reason": "To show steps, heart rate and calories",
        "required": false
      },
      {
        "name": "Calendar",
        "reason": "To show calendar events from your complications",
        "required": false
      },
      {
        "name": "ReadMusic",
        "reason": "To show music info from your complications",
        "required": false
      }
    ]
  }
}

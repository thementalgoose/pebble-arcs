{
  "name": "pebble-arcs",
  "author": "thementalgoose",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "ARCs",
    "uuid": "0122e256-9254-4bbd-9079-f4afd0819b1a",
    "sdkVersion": "3",
    "manifestVersion": 2,
    "enableMultiJS": true,
    "capabilities": [
      "health",
      "configurable"
    ],
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "DarkTheme",
      "BatteryIndicator",
      "QuietTimeIndicator",
      "DisconnectIndicator",
      "OutlinedArcs",
      "ShowIndicatorText",
      "IndicatorWidth",
      "TopLeft_Option",
      "TopLeft_Colour",
      "TopRight_Option",
      "TopRight_Colour",
      "BottomLeft_Option",
      "BottomLeft_Colour",
      "BottomRight_Option",
      "BottomRight_Colour",
      "StepGoal",
      "CalorieGoal",
      "HeartRateLower",
      "HeartRateUpper",
      "WeatherTemperature",
      "WeatherCondition",
      "WeatherRequestUpdate",
      "WeatherUpdateInterval",
      "WeatherUseCelsius",
      "TemperatureLower",
      "TemperatureUpper",
      "DistanceGoal",
      "PhoneBattery"
    ],
    "resources": {
      "media": [
        {
          "file": "images/icon_bw.png",
          "type": "bitmap",
          "name": "MENU_ICON",
          "memoryFormat": "1Bit",
          "menuIcon": true,
          "targetPlatforms": [
            "aplite",
            "diorite",
            "flint"
          ]
        },
        {
          "file": "images/icon_color.png",
          "type": "bitmap",
          "name": "MENU_ICON",
          "targetPlatforms": [
            "basalt",
            "chalk",
            "emery",
            "gabbro"
          ]
        }
      ]
    },
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "api.open-meteo.com"
          ]
        },
        "reason": "To fetch the current weather",
        "required": false
      },
      {
        "name": "Location",
        "reason": "To show the weather where you are",
        "required": false
      },
      {
        "name": "Health",
        "reason": "To show steps, heart rate and calories",
        "required": false
      }
    ]
  }
}
